# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Browser Configuration
HEADLESS=false
TIMEOUT=30000
LOG_LEVEL=INFO

# Gmail Credentials (for real automation)
# Note: You may need to use an App Password if 2FA is enabled
GMAIL_EMAIL=your_gmail@gmail.com
GMAIL_PASSWORD=your_gmail_app_password

# Outlook Credentials (for real automation)
OUTLOOK_EMAIL=your_outlook@outlook.com
OUTLOOK_PASSWORD=your_outlook_password

# Optional: Screenshot Directory
# SCREENSHOT_DIR=./screenshots
